fn usz start_o_len() { return 760; }

extern fn void* fopen(char* path, char* mode);
extern fn usz   fwrite(void* ptr, usz size, usz nmemb, void* file);
extern fn int   fclose(void* f);
extern fn int   remove(char* path);
extern fn int   system(char* cmd);
extern fn int   printf(char* fmt, ...);

const usz LINK_PATH_MAX = 4096;

fn bool write_bytes(char* path, char* data, usz len)
{
    void* f = fopen(path, (char*)"wb");
    if (f == null) return false;
    usz w = fwrite(data, 1, len, f);
    (void)fclose(f);
    return w == len;
}

fn bool pear_link_exe(AirModule* mod, char* src_path)
{
    if (mod == null || src_path == null) return false;

    char[LINK_PATH_MAX] obj_path;
    char[LINK_PATH_MAX] start_path;
    char[LINK_PATH_MAX] exe_path;
    char[LINK_PATH_MAX] cmd;

    int sl = -1; int dl = -1; int n = 0;
    while (src_path[n] != 0) {
        if (src_path[n] == '/') sl = n;
        if (src_path[n] == '.') dl = n;
        n++;
    }
    bool has_ext = (dl > sl) && (dl > 0) && (dl < n - 1);
    int base_len_i = has_ext ? dl : n;
    usz base_len = (usz)base_len_i;

    {
        int k = 0;
        for (usz j = 0; j < base_len; j++) { obj_path[k++] = src_path[j]; }
        obj_path[k] = '.'; obj_path[k+1] = 'o'; obj_path[k+2] = 0;
    }
    {
        int k = 0;
        for (usz j = 0; j < base_len; j++) { start_path[k++] = src_path[j]; }
        (void)snprintf(&start_path[k], LINK_PATH_MAX - (usz)k, "_start.o");
    }
    {
        int k = 0;
        for (usz j = 0; j < base_len; j++) { exe_path[k++] = src_path[j]; }
        exe_path[k] = 0;
    }

    if (!pear_emit_obj(mod, &obj_path[0]))
    {
        printf("pear: failed to emit native object\n");
        return false;
    }

    if (!write_bytes(&start_path[0], start_o_bytes(), start_o_len()))
    {
        (void)remove(&obj_path[0]);
        printf("pear: failed to write embedded _start.o\n");
        return false;
    }

    (void)snprintf(&cmd[0], LINK_PATH_MAX,
        (char*)"ld %s %s -o %s --entry=_start -nostdlib -no-pie",
        &start_path[0], &obj_path[0], &exe_path[0]);
    int rc = system(&cmd[0]);

    (void)remove(&obj_path[0]);
    (void)remove(&start_path[0]);
    return rc == 0;
}
