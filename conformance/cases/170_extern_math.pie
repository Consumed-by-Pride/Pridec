-- EXPECT-CLEAN
-- Declaration attributes sit AFTER the signature, not between the name and it:
-- tests/pfront/syntax/x07_meta_attrs.pie:23 spells an extern
-- `fn ext_sin : f64 -> f64 #extern("sin") #cc(c)`, and that is the only form the
-- parser accepts. The `fn puts #[extern("puts")] : ptr -> i32` spelling used
-- here failed with E1050 "expected an expression" on the attribute.
fn sqrt : f64 -> f64 #[extern("sqrt")]
fn fabs : f64 -> f64 #[extern("fabs")]
fn floor : f64 -> f64 #[extern("floor")]
fn ceil : f64 -> f64 #[extern("ceil")]
fn sin : f64 -> f64 #[extern("sin")]
fn cos : f64 -> f64 #[extern("cos")]
fn exp : f64 -> f64 #[extern("exp")]
fn log : f64 -> f64 #[extern("log")]
fn pow : (f64, f64) -> f64 #[extern("pow")]

fn hypotenuse : (f64, f64) -> f64
  | (a, b) -> sqrt(a * a + b * b)

fn circle_area : f64 -> f64
  | r -> 3.14159265358979 * r * r
