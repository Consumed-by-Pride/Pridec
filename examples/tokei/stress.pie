mod tokei.stress

-- Generated deterministic compile-time workload: hundreds of small, distinct
-- functions stress parsing, name lookup, local binding, branches and calls.
-- It is intentionally ordinary Pride source rather than generated binary data.

fn stress_case_000 : i64 -> i64
  | seed ->
      let offset_000 = seed + 1i64
      let scaled_000 = offset_000 * 3i64
      let chosen_000 = if scaled_000 > 7i64 then scaled_000 - 1i64 else scaled_000 + 4i64
      let result_000 = chosen_000 + offset_000 * 2i64
      result_000

