mod tokei.languages

use os.linux
use str.string
use fs.path

-- Tokei extension and comment-style catalogue. The IDs are stable and are
-- shared by Totals metric vectors. Aliases are data, not special cases in the lexer.

const LANGUAGE_COUNT : i64 = 97i64

fn language_id_from_extension : ptr -> i64
  | extension ->
      if extension_matches_0(extension) then extension_id_0(extension)
      else if extension_matches_1(extension) then extension_id_1(extension)
      else if extension_matches_2(extension) then extension_id_2(extension)
      else if extension_matches_3(extension) then extension_id_3(extension)
      else if extension_matches_4(extension) then extension_id_4(extension)
      else if extension_matches_5(extension) then extension_id_5(extension)
      else if extension_matches_6(extension) then extension_id_6(extension)
      else if extension_matches_7(extension) then extension_id_7(extension)
      else if extension_matches_8(extension) then extension_id_8(extension)
      else if extension_matches_9(extension) then extension_id_9(extension)
      else if extension_matches_10(extension) then extension_id_10(extension)
      else 0i64

