// A heap size of zero is refused: a zero-byte object has no addressable byte, and
// the program that asks for one has a bug the compiler can point at. A size the
// program *computes* is no longer refused -- see dynamic_malloc_main.air -- but a
// literal that can never work still is.
air 3.0 Main "reject_dynamic_malloc_main.pie";

extern declare malloc(size : i64) : ptr(i8);

def empty() : ptr(i8) =
  mu~ %ret.
    <malloc | call · 0 : i64 · %ret>;

def main() : i64 = mu~ %ret. <0 : i64 | %ret>;
