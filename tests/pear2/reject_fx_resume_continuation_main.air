// M10 reject: handler arm cuts to the `%resume` continuation (resuming
// handler) — not lowerable in the escape-only subset.
air 2.2 Main "reject_resume_continuation.pie";

effect E {
  op `op` : i64;
};

def main() : i64 =
  mu~ %ret_2.
    handle {
      perform `E.op`(1 : i64) · comu _k1. <_k1 : i64 | %ret_2>
    } {
      ctor `E.op`(bind x, _) -> <x : i64 | %resume>;
    };
