// PEAR2: UTF-8 string/byte literals lower as fixed arrays of i8 for local aggregate use.
air 2.2 Main "bytes_local_main.pie";

def main() : i64 =
  mu~ %ret.
    <"OK" : array#3(i8) | comu bytes.
      match bytes {
        array(bind first, bind second, bind terminator) ->
          if (eq first 79 : i8) then
            if (eq second 75 : i8) then
              if (eq terminator 0 : i8) then
                <42 | %ret>
              else
                <0 | %ret>
            else
              <0 | %ret>
          else
            <0 | %ret>;
      }>;
