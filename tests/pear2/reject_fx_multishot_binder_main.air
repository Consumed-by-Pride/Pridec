// M10 reject: handler arm invokes its continuation binder (resuming /
// multi-shot shape) — positioned fail-closed diagnostic.
air 2.2 Main "reject_multishot.pie";

effect E {
  op `op` : i64;
};

def main() : i64 =
  mu~ %ret_2.
    handle {
      perform `E.op`(1 : i64) · comu _k1. <_k1 : i64 | %ret_2>
    } {
      ctor `E.op`(bind x, bind k) -> <k | call · 2 : i64 · comu _v. <_v : i64 | %ret_2>>;
    };
