// PEAR 2 M3 subset: i64 pointer load/store through AIR2 continuations.
air 2.2 Main "memory_i64_main.pie";

def roundtrip(p : ptr(i64)) : i64 =
  mu~ %ret.
    <p | store(42 : i64; 8) · comu _.
      <p | deref · comu loaded.
        <loaded | %ret>>>;

def main() : i64 =
  mu~ %ret.
    <0 | %ret>;
