// M10 reject: an effect operation with `infer` payload type has no concrete
// representation for the payload slot — rejected with a source position.
air 2.2 Main "reject_infer_payload.pie";

effect E {
  op `op` : infer;
};

def main() : i64 =
  mu~ %ret_2.
    handle {
      perform `E.op`(1 : i64) · comu _k1. <_k1 : i64 | %ret_2>
    } {
      ctor `E.op`(bind x, _) -> <x : i64 | %ret_2>;
    };
