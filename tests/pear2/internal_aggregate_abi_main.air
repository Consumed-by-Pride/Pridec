// PEAR2: internal tuple values may cross direct-call parameter and return boundaries.
air 2.2 Main "internal_aggregate_abi_main.pie";

def identity_pair(p : tuple(i32, bool)) : tuple(i32, bool) =
  mu~ %ret.
    <p | %ret>;

def main() : i64 =
  mu~ %ret.
    <identity_pair | call · tuple(42 : i32, true) : tuple(i32, bool) · comu pair.
      <pair | proj 0 · comu number.
        <pair | proj 1 · comu flag.
          if (eq number 42 : i32) then
            if flag then
              <42 | %ret>
            else
              <0 | %ret>
          else
            <0 | %ret>>>>;
