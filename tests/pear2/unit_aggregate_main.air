// PEAR2: unit can occupy an empty LLVM aggregate field across an internal call ABI.
air 2.2 Main "unit_aggregate_main.pie";

def identity(p : tuple(unit, i32)) : tuple(unit, i32) =
  mu~ %ret.
    <p | %ret>;

def unit_parameter(value : unit) : i64 =
  mu~ %ret.
    <42 | %ret>;

def exercise_unit_call() : i64 =
  mu~ %ret.
    <unit_parameter | call · unit · %ret>;

def main() : i64 =
  mu~ %ret.
    <identity | call · tuple(unit, 42 : i32) : tuple(unit, i32) · comu pair.
      <pair | proj 1 · comu number.
        <number | %ret>>>;
