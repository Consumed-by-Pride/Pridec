// PEAR2 M9 fail-closed check: a label with more incoming control-flow edges
// than the phi promotion table holds (16) is rejected with a source position
// instead of overflowing the bookkeeping arrays.
air 2.2 Main "reject_label_edge_overflow.pie";

def main() : i64 =
  mu~ %ret.
    seq {
      label join(x : i64).
        <x | %ret>;
      let v1 = 1 : i64 in
        let v2 = 2 : i64 in
        let v3 = 3 : i64 in
        let v4 = 4 : i64 in
        let v5 = 5 : i64 in
        let v6 = 6 : i64 in
        let v7 = 7 : i64 in
        let v8 = 8 : i64 in
        let v9 = 9 : i64 in
        let v10 = 10 : i64 in
        let v11 = 11 : i64 in
        let v12 = 12 : i64 in
        let v13 = 13 : i64 in
        let v14 = 14 : i64 in
        let v15 = 15 : i64 in
        let v16 = 16 : i64 in
        let v17 = 17 : i64 in
        if (eq v1 0 : i64) then jump join(v1) else if (eq v2 0 : i64) then jump join(v2) else if (eq v3 0 : i64) then jump join(v3) else if (eq v4 0 : i64) then jump join(v4) else if (eq v5 0 : i64) then jump join(v5) else if (eq v6 0 : i64) then jump join(v6) else if (eq v7 0 : i64) then jump join(v7) else if (eq v8 0 : i64) then jump join(v8) else if (eq v9 0 : i64) then jump join(v9) else if (eq v10 0 : i64) then jump join(v10) else if (eq v11 0 : i64) then jump join(v11) else if (eq v12 0 : i64) then jump join(v12) else if (eq v13 0 : i64) then jump join(v13) else if (eq v14 0 : i64) then jump join(v14) else if (eq v15 0 : i64) then jump join(v15) else if (eq v16 0 : i64) then jump join(v16) else jump join(v17)
    };
