// AIR 3: pointer cells belong to the function that made them.
//
// A local allocation is named by an SSA temporary, and temporaries restart at
// `%t0` in every function. Two functions that each store a heap pointer in a
// local cell therefore use the *same* cell name -- and if cells were shared
// across bodies, `second` below would inherit `first`'s eight-byte extent and
// its `gep(quad, 3)` would be rejected as an escape from an object it is not
// pointing into. Both bodies allocate, store, reload, index and free exactly the
// same way; only their sizes differ.
//
// first(5) = 5, second(7) = 7, exit 12.
air 3.0 Main "pointer_cell_scopes_main.pie";

extern declare malloc(size : i64) : ptr(i64);
extern declare free(p : ptr(i64)) : unit;

def first(v : i64) : i64 =
  mu~ %ret.
    <alloca(ptr(i64)) : ptr(ptr(i64)) | comu cell.
      <malloc | call · 8 : i64 · comu heap.
        seq {
          store(cell, heap);
          <load(cell) : ptr(i64) | comu alias.
            seq {
              store(alias, v);
              <load(alias) : i64 | comu got.
                <free | call · alias · comu _.
                  <got | %ret>
                >
              >
            }
          >
        }
      >
    >;

def second(v : i64) : i64 =
  mu~ %ret.
    <alloca(ptr(i64)) : ptr(ptr(i64)) | comu slot.
      <malloc | call · 32 : i64 · comu buf.
        seq {
          store(slot, buf);
          <load(slot) : ptr(i64) | comu quad.
            seq {
              store(gep[i64](quad, 3 : i64) : ptr(i64), v);
              <load(gep[i64](quad, 3 : i64) : ptr(i64)) : i64 | comu got.
                <free | call · quad · comu _.
                  <got | %ret>
                >
              >
            }
          >
        }
      >
    >;

def main() : i64 =
  mu~ %ret.
    <first | call · 5 : i64 · comu a.
      <second | call · 7 : i64 · comu b.
        <(add a b) : i64 | %ret>>>;
