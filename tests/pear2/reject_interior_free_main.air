// free only accepts the live base pointer, not an interior GEP result.
air 3.0 Main "reject_interior_free_main.pie";

extern declare malloc(size : i64) : ptr(i64);
extern declare free(p : ptr(i64)) : unit;

def bad_free() : i64 =
  mu~ %ret.
    <malloc | call · 16 : i64 · comu heap.
      <gep[i64](heap, 1 : i64) : ptr(i64) | comu interior.
        <free | call · interior · comu _.
          <0 : i64 | %ret>>
      >
    >;

def main() : i64 = mu~ %ret. <0 : i64 | %ret>;
