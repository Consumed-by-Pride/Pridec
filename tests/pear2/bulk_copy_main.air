// AIR 3: `memcpy` is checked like any other access.
//
// A copy has no element type, so the only thing to establish is the bound -- and
// the length is an argument, which means it can be a register. `copy_fixed` copies
// eight bytes with a literal length (proved at compile time against the tracked
// extents); `copy_var` copies eight bytes with a length the program computes, so
// the emitted check compares against that register instead.
//
// copy_fixed = 99, copy_var = 91, exit 8.
air 3.0 Main "bulk_copy_main.pie";

extern declare malloc(size : i64) : ptr(i64);
extern declare free(p : ptr(i64)) : unit;
extern declare memcpy(dst : ptr(u8), src : ptr(u8), n : i64) : ptr(u8);

def copy_fixed() : i64 =
  mu~ %ret.
    <alloca(i64) : ptr(i64) | comu source.
      <malloc | call · 16 : i64 · comu dest.
        seq {
          store(source, 99 : i64);
          <memcpy | call · dest · source · 8 : i64 · comu _.
            <load(dest) : i64 | comu got.
              <free | call · dest · comu _.
                <got | %ret>
              >
          >
        }
      >
    >;

def copy_var(n : i64) : i64 =
  mu~ %ret.
    <alloca(i64) : ptr(i64) | comu source.
      <malloc | call · 16 : i64 · comu dest.
        seq {
          store(source, 91 : i64);
          <memcpy | call · dest · source · n · comu _.
            <load(dest) : i64 | comu got.
              <free | call · dest · comu _.
                <got | %ret>
              >
          >
        }
      >
    >;

def main() : i64 =
  mu~ %ret.
    <copy_fixed | call · comu a.
      <copy_var | call · 8 : i64 · comu b.
        <(sub a b) : i64 | %ret>>>;
