// AIR 3.0 inline asm: a template-only barrier (unit result, AT&T dialect,
// memory-clobbered) followed by a one-operand value-producing asm.
// 40 + 2 via the template; exit 42.
air 3.0 Main "asm_main.pie";

def main() : i64 =
  mu~ %ret.
    asm "nop" "~{memory}" : [unit] () · comu _.
      <40 : i64 | comu base.
        asm "addq $$2, $0" "=r,0" : [i64] (base) · comu total.
          <total : i64 | %ret>>;
