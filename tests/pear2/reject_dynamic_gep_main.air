// AIR 3 dynamic pointer offsets: what is still refused.
//
// One dynamic step is checked at the point of use, and a chain of GEPs may each
// carry one (`p[i][j]`). Two dynamic indices inside a *single* GEP cannot be
// handled the same way: the producer has one result type and one address, so
// there is nowhere to attach two checks, and the second index's bound would
// depend on the value of the first. Refusing is the honest answer, and it is
// reported at the GEP with a source position rather than becoming an unchecked
// access later.
air 3.0 Main "reject_dynamic_gep_main.pie";

def bad_offset(row : i64, col : i64) : ptr(i64) =
  mu~ %ret.
    <alloca(array#2(array#2(i64))) : ptr(array#2(array#2(i64))) | comu base.
      <gep[array#2(array#2(i64))](base, 0 : i64, row, col) : ptr(i64) | %ret>>;

def main() : i64 = mu~ %ret. <0 : i64 | %ret>;
