-- EXIT: 9
-- AIR 2.2 memory + mu/label: the heap buffer is written through a loop and
-- freed once, after the loop's exit join. The free must sit on the join block
-- that the loop's backedge and its exit branch both reach, not inside the body.
fn main(_) -> i64 ! [Alloc] {
  let a : *i64 = alloc [i64; 3];
  let mut i: i64 = 0;
  while i < 3 { a[i] = i + 1; i = i + 1; }
  let last: i64 = a[2];
  free a;
  return last * 3;
}
