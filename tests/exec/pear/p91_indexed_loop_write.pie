-- EXIT: 3
-- PEAR v0.8.8: indexed stores inside a while-loop survive and a[i] on *i64
-- computes element offsets (multi-byte GEP). Stores a[i]=i for i=0..7 then
-- reads a[3] → 3.
fn main(_) -> i64 ! [Alloc] {
  let a : *i64 = alloc [i64; 8];
  let mut i : i64 = 0;
  while i < 8 { a[i] = i; i = i + 1; }
  return a[3];
}
