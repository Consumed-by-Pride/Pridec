-- EXIT: 42
-- Full idiom: a closure over a runtime capture is applied and its result is
-- printed digit-by-digit via alloc + while + pointer index/store -- the
-- memory/mu subset extension that makes raw-memory code work on AIR 2.2.
fn print_i64_nl : i64 -> () ! [IO, Alloc]
  | n ->
      let buf : *u8 = alloc [u8; 25]
      let mut pos : i64 = 0
      let mut x : i64 = n
      if x == 0
        buf[pos] = 48u8
        pos = pos + 1
      else
        let tmp : *u8 = alloc [u8; 21]
        let mut tlen : i64 = 0
        while x > 0
          tmp[tlen] = (x % 10 + 48) as u8
          x = x / 10
          tlen = tlen + 1
        let mut k : i64 = tlen - 1
        while k >= 0
          buf[pos] = tmp[k]
          pos = pos + 1
          k = k - 1
        free tmp
      buf[pos] = 10u8
      syscall(1, 1, buf as i64, pos + 1)
      free buf

fn adder : i64 -> fn(i64) -> i64
  | base -> fn (x: i64) -> i64 { x + base }

fn main : () -> () ! [IO, Alloc]
  | () ->
      let f = adder(40)
      let r = f(2)
      syscall(231, r)
