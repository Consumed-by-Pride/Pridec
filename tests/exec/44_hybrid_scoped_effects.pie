mod tests.exec.test_44_hybrid_scoped_effects

use pride.effects
use pride.ub

-- tests/exec/44_hybrid_scoped_effects.pie
-- Complex execution test for Hybrid Fiber + Untyped Prompt Engine
-- and Two-Part Functorial Delimited Continuations (k_in / k_out).

-- The fiber body: yields 1 and 2 back to the resumer, then finishes. It is handed to the runtime as a RAW
-- C function pointer (`fiber_entry as ptr`), which is what `void* (*)(void*)` in compiler_rt expects.
fn fiber_entry : ptr -> ptr
    | _arg ->
        let _a : ptr = effects.fiber_yield(1);
        let _b : ptr = effects.fiber_yield(2);
        null

fn test_fiber_execution : () -> bool
    | () ->
        let fib : ptr = effects.fiber_spawn(fiber_entry as ptr, null);
        let r1 : i64 = effects.fiber_resume(fib, 0) as i64;
        let r2 : i64 = effects.fiber_resume(fib, 0) as i64;
        r1 == 1 && r2 == 2

fn test_scoped_prompt_continuations : () -> bool
    | () ->
        let pid : i64 = 99;
        let marker : i64 = effects.prompt_install(pid);
        let in_sc : bool = effects.is_in_scope(pid);
        
        -- Split continuation into k_in and k_out
        let cont : ptr = effects.cont_split(null);
        -- fuse(split(k)) must hand back a usable continuation (with no frame dispatched both halves are
        -- empty, and the runtime still returns a fresh, non-null buffer)
        let fused_k : ptr = effects.cont_fuse(cont);
        let law_ok : bool = cont != null && fused_k != null;
        
        effects.prompt_unwind(marker);
        let after_sc : bool = effects.is_in_scope(pid);
        in_sc && !after_sc && law_ok

fn run_all : () -> i32
    | () ->
        let f_ok : bool = test_fiber_execution();
        let s_ok : bool = test_scoped_prompt_continuations();
        ub.assume(f_ok && s_ok);
        if f_ok && s_ok then 0 else 1

fn main : () -> i32
    | () ->
        run_all()
