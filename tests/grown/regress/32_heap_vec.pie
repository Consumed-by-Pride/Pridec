struct Vec
  data : *i64
  len : i64
  cap : i64

fn vec_new : () -> Vec
  | () ->
      let v : Vec = Vec { data: alloc [i64; 4], len: 0i64, cap: 4i64 }
      v

fn vec_push : (*Vec, i64) -> ()
  | (v, x) ->
      if v.len >= v.cap
        let bigger : *i64 = alloc [i64; v.cap * 2i64]
        let mut i : i64 = 0i64
        while i < v.len
          bigger[i] = v.data[i]
          i = i + 1i64
        free v.data
        v.data = bigger
        v.cap = v.cap * 2i64
      v.data[v.len] = x
      v.len = v.len + 1i64

fn vec_sum : *Vec -> i64
  | v ->
      let mut s : i64 = 0i64
      let mut i : i64 = 0i64
      while i < v.len
        s = s + v.data[i]
        i = i + 1i64
      s

fn main : () -> i64
  | () ->
      let mut v = vec_new()
      let mut i : i64 = 1i64
      while i <= 20i64
        vec_push(&v, i)
        i = i + 1i64
      let mut s = vec_sum(&v)
      free v.data
      if s != 210i64
        s = 0i64 - 1i64
      s - 210i64
