-- EXIT: 0
-- grown regression corpus: generated by gen_corpus.py

enum Step
  Push(i64)
  Op(i64)

fn run : [Step; 7] -> i64
  | prog ->
      let st : *i64 = alloc [i64; 8]
      let mut sp : i64 = 0i64
      let mut bad : i64 = 0i64
      for step in prog
        match step
          | Push(v) ->
              st[sp] = v
              sp = sp + 1i64
          | Op(code) ->
              if sp >= 2i64
                let b = st[sp - 1i64]
                let a = st[sp - 2i64]
                sp = sp - 2i64
                if code == 1i64
                  st[sp] = a + b
                  sp = sp + 1i64
                else if code == 2i64
                  st[sp] = a - b
                  sp = sp + 1i64
                else
                  st[sp] = a * b
                  sp = sp + 1i64
              else
                bad = 1i64
      let mut r = st[0]
      free st
      if bad != 0i64
        r = 0i64 - 1i64
      r

fn main : () -> i64
  | () ->
      let prog : [Step; 7] = [Step.Push(5i64), Step.Push(3i64), Step.Op(1i64), Step.Push(4i64), Step.Op(3i64), Step.Push(2i64), Step.Op(2i64)]
      let mut r = run(prog)
      if r != 24i64
        r = r * 0i64 - 1i64
      24i64 - r
