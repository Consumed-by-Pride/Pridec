-- EXIT: 0
-- grown regression corpus: generated by gen_corpus.py

fn is_even : i64 -> bool
  | 0 -> true
  | n -> is_odd(n - 1i64)

fn is_odd : i64 -> bool
  | 0 -> false
  | n -> is_even(n - 1i64)

fn ack : (i64, i64) -> i64
  | (0, n) -> n + 1i64
  | (m, 0) -> ack(m - 1i64, 1i64)
  | (m, n) -> ack(m - 1i64, ack(m, n - 1i64))

fn main : () -> i64
  | () ->
      let mut f : i64 = 0i64
      if is_even(10i64) != true
        f = f + 1i64
      if is_odd(7i64) != true
        f = f + 2i64
      if ack(2i64, 3i64) != 9i64
        f = f + 4i64
      f
