-- EXIT: 0
-- grown regression corpus: generated by gen_corpus.py

struct Inner
  x : i64
  y : i64

struct Outer
  tag : i64
  first : Inner
  second : Inner

fn make : (i64, i64) -> Outer
  | (a, b) ->
      let o : Outer = Outer { tag: 1i64, first: Inner { x: a, y: a + 1i64 }, second: Inner { x: b, y: b + 1i64 } }
      o

fn main : () -> i64
  | () ->
      let o = make(10i64, 20i64)
      let mut f : i64 = 0i64
      if o.first.y != 11i64
        f = f + 1i64
      if o.second.x != 20i64
        f = f + 2i64
      let mut q = o
      q.first.x = 77i64
      if o.first.x != 10i64
        f = f + 4i64
      if q.first.x != 77i64
        f = f + 8i64
      f
