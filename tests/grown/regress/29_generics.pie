-- grown regression corpus: generated by gen_corpus.py

fn pick_max<T> : (T, T, T) -> T
  | (a, b, c) ->
      let mut best = a
      if b > best
        best = b
      if c > best
        best = c
      best

fn pair_first<T> : (T, T) -> T
  | (a, _) -> a

fn main : () -> i64
  | () ->
      let mut f : i64 = 0i64
      if pick_max<i64>(3i64, 9i64, 5i64) != 9i64
        f = f + 1i64
      if pair_first<i64>(7i64, 8i64) != 7i64
        f = f + 2i64
      let u8m = pick_max<u8>(7u8, 200u8, 100u8)
      if u8m != 200u8
        f = f + 4i64
      f
