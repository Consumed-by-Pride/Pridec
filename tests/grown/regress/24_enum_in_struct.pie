-- EXIT: 0
-- grown regression corpus: generated by gen_corpus.py

enum Tok
  Num(i64)
  Plus
  Eof

struct Slot
  t : Tok
  line : i64

fn describe : Slot -> i64
  | s ->
      match s.t
        | Num(v) -> v * 10i64 + s.line
        | Plus -> 100i64 + s.line
        | Eof -> 1000i64 + s.line

fn main : () -> i64
  | () ->
      let a : Slot = Slot { t: Tok.Num(7i64), line: 3i64 }
      let b : Slot = Slot { t: Tok.Plus, line: 4i64 }
      let mut f : i64 = 0i64
      if describe(a) != 73i64
        f = f + 1i64
      if describe(b) != 104i64
        f = f + 2i64
      f
