fn strlen : ptr -> i64
  | p ->
      let b = p as *u8
      let mut n : i64 = 0i64
      while b[n] != 0u8
        n = n + 1i64
      n

fn count_char : (ptr, u8) -> i64
  | (p, want) ->
      let b = p as *u8
      let mut n : i64 = 0i64
      let mut i : i64 = 0i64
      while b[i] != 0u8
        if b[i] == want
          n = n + 1i64
        i = i + 1i64
      n

