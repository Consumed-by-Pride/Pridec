fn fib : i64 -> i64
  | 0 -> 0
  | 1 -> 1
  | n -> fib(n - 1i64) + fib(n - 2i64)

fn main : () -> i64
  | () ->
      let mut f : i64 = 0i64
      if fib(10i64) != 55i64
        f = f + 1i64
      if fib(20i64) != 6765i64
        f = f + 2i64
      f
