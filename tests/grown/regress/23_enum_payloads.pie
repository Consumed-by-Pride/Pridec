-- EXIT: 0
-- grown regression corpus: generated by gen_corpus.py

enum Shape
  Circle(i64)
  Rect(i64, i64)
  Dot

fn area : Shape -> i64
  | Circle(r) -> 3i64 * r * r
  | Rect(w, h) -> w * h
  | Dot -> 0i64

fn main : () -> i64
  | () ->
      let mut f : i64 = 0i64
      if area(Shape.Circle(2i64)) != 12i64
        f = f + 1i64
      if area(Shape.Rect(3i64, 4i64)) != 12i64
        f = f + 2i64
      if area(Shape.Dot) != 0i64
        f = f + 4i64
      let s = Shape.Rect(10i64, 20i64)
      if area(s) != 200i64
        f = f + 8i64
      f
