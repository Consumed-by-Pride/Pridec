-- EXIT: 0
-- grown regression corpus: generated by gen_corpus.py

enum Tree
  Leaf(i64)
  Node(Tree, Tree)

fn depth : Tree -> i64
  | Leaf(_) -> 1i64
  | Node(l, r) ->
      let dl = depth(l)
      let dr = depth(r)
      if dl > dr
        dl + 1i64
      else
        dr + 1i64

fn total : Tree -> i64
  | Leaf(v) -> v
  | Node(l, r) -> total(l) + total(r)

fn main : () -> i64
  | () ->
      let t : Tree = Tree.Node(Tree.Leaf(1i64), Tree.Node(Tree.Leaf(2i64), Tree.Leaf(3i64)))
      let mut f : i64 = 0i64
      if depth(t) != 3i64
        f = f + 1i64
      if total(t) != 6i64
        f = f + 2i64
      f
