-- EXIT: 0
-- grown regression corpus: generated by gen_corpus.py

const SCALE : i64 = 1000i64
const TABLE : [i64; 5] = [2, 3, 5, 7, 11]

let mut COUNTER : i64 = 0i64

fn bump : () -> i64
  | () ->
      COUNTER = COUNTER + SCALE
      COUNTER

fn main : () -> i64
  | () ->
      let mut f : i64 = 0i64
      if bump() != 1000i64
        f = f + 1i64
      if bump() != 2000i64
        f = f + 2i64
      let mut t : i64 = 0i64
      for v in TABLE
        t = t + v
      if t != 28i64
        f = f + 4i64
      f
