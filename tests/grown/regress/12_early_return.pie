-- EXIT: 0
-- grown regression corpus: generated by gen_corpus.py

fn find : (i64, i64) -> i64
  | (target, cap) ->
      for i in 0..cap
        if i * i >= target
          return i
      -1i64

fn main : () -> i64
  | () ->
      let mut f : i64 = 0i64
      if find(17i64, 10i64) != 5i64
        f = f + 1i64
      if find(0i64, 3i64) != 0i64
        f = f + 2i64
      if find(1000i64, 10i64) != -1i64
        f = f + 4i64
      f
