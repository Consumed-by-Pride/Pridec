-- grown regression corpus: generated by gen_corpus.py

struct Sq
  s : i64

struct Ci
  r : i64

interface Area
  fn area : Self -> i64

impl Area for Sq
  fn area : Self -> i64 | q -> q.s * q.s

impl Area for Ci
  fn area : Self -> i64 | c -> 3i64 * c.r * c.r

fn total_area : (Sq, Ci) -> i64
  | (a, b) -> a.area() + b.area()

fn main : () -> i64
  | () ->
      let sq : Sq = Sq { s: 5i64 }
      let ci : Ci = Ci { r: 2i64 }
      let mut f : i64 = 0i64
      if Area.area(sq) != 25i64
        f = f + 1i64
      if Area.area(ci) != 12i64
        f = f + 2i64
      if total_area(sq, ci) != 37i64
        f = f + 4i64
      f
