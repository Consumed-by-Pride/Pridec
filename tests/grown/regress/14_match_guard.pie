-- EXIT: 0
-- grown regression corpus: generated by gen_corpus.py

fn clamp_word : i64 -> i64
  | n if n < 0 -> 0i64
  | n if n > 255i64 -> 255i64
  | n -> n

fn main : () -> i64
  | () ->
      let mut f : i64 = 0i64
      if clamp_word(-5i64) != 0i64
        f = f + 1i64
      if clamp_word(1000i64) != 255i64
        f = f + 2i64
      if clamp_word(100i64) != 100i64
        f = f + 4i64
      f
