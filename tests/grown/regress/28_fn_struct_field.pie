-- EXIT: 0
-- grown regression corpus: generated by gen_corpus.py

struct Ops
  name_id : i64
  add : fn(i64, i64) -> i64
  mul : fn(i64, i64) -> i64

fn iadd : (i64, i64) -> i64
  | (a, b) -> a + b

fn imul : (i64, i64) -> i64
  | (a, b) -> a * b

fn run_ops : (*Ops, i64) -> i64
  | (o, v) ->
      let s = o.add(v, v)
      let p = o.mul(v, v)
      s + p

fn main : () -> i64
  | () ->
      let table : Ops = Ops { name_id: 1i64, add: iadd, mul: imul }
      let mut heap : *Ops = alloc [Ops; 1]
      heap[0].name_id = 2i64
      heap[0].add = iadd
      heap[0].mul = imul
      let mut f : i64 = 0i64
      if run_ops(&table, 3i64) != 15i64
        f = f + 1i64
      if run_ops(heap, 5i64) != 35i64
        f = f + 2i64
      free heap
      f
