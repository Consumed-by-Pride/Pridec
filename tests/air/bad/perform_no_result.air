// EXPECT: check
air 2.2 Main "perform.pie";

effect E {
  op `i64` : infer;
};

def f() : i64 =
  mu~ %ret_2.
    match unit {
      tuple() ->
        handle {
          <mu %k1.
            perform `E.op`(1 : infer) | %ret_2>
        } {
          ctor `E.op`(bind x, bind k) ->
            <2 : infer | %resume>;
        };
    };

def main() : i64 =
  mu~ %ret_2.
    match unit {
      tuple() ->
        <f | call · comu _x1.
          <(add _x1 1 : infer) | %ret_2>>;
    };

