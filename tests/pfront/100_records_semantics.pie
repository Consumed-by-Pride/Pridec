-- EXPECT: records are translated into TypeStore rows with owned fields;
-- pairwise width/depth, projection and empty-intersection checks are audited.
struct RecordInt
  id : i32
  value : i32
  flag : bool

struct RecordWide
  id : i32
  value : i32
  flag : bool
  label : bool

struct RecordConflict
  id : bool
  value : i32

struct RecordDepthConflict
  id : i32
  value : bool

struct RecordDistinct
  name : i32
  enabled : bool
