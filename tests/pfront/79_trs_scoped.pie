-- Rewrite rules are VALUES (spec §16): they fire only at `|>`.
-- `zero` must keep its 0; `a` must become 1; the rule's own lhs must stay 0.
fn zero : () -> i64
  | () -> 0i64

fn main : () -> i64
  | () ->
      let opt : Rewrite = rewrite
        | 0i64 ↦ 1i64
      let a = 0i64 |> opt
      a + zero()
