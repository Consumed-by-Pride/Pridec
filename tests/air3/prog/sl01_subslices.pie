-- EXIT: 17
-- `x[lo..hi]` and `x[lo..=hi]` on an array, a slice of a slice, an empty range, and writing through a sub-slice into the array
fn sum : [i64] -> i64
  | xs ->
      let mut s : i64 = 0
      for x in xs
        s = s + x
      s
fn bump : [i64] -> ()
  | xs -> xs[0] = xs[0] + 100
fn main : () -> i64
  | () ->
      let mut a : [i64; 6] = [1, 2, 3, 4, 5, 6]
      let b = a[1..4]
      let c = b[1..3]
      bump(a[4..6])
      let e = a[2..2]
      sum(b) + sum(c) + sum(a[2..=3]) + sum(e) + a[4] - 111
