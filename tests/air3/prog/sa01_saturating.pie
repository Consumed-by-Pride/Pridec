-- EXIT: 0
-- `*|` saturating multiply, checked exhaustively for i8 and u8 against a widened reference, plus i32/i64/u64 edge cases.  Returns the number of mismatches.
fn clamp_s8 : (i64) -> i8
  | (v) -> if v > 127i64 then 127i8 else if v < -128i64 then -128i8 else v as i8

fn clamp_u8 : (i64) -> u8
  | (v) -> if v > 255i64 then 255u8 else v as u8

fn main : () -> i64
  | () ->
    let mut bad : i64 = 0i64
    let mut x : i64 = -128i64
    while x <= 127i64
      let mut y : i64 = -128i64
      while y <= 127i64
        let a = x as i8
        let b = y as i8
        if (a *| b) != clamp_s8(x * y)
          bad = bad + 1i64
        y = y + 1i64
      x = x + 1i64
    let mut p : i64 = 0i64
    while p <= 255i64
      let mut q : i64 = 0i64
      while q <= 255i64
        let a = p as u8
        let b = q as u8
        if (a *| b) != clamp_u8(p * q)
          bad = bad + 1i64
        q = q + 1i64
      p = p + 1i64
    let i32max : i32 = 2147483647i32
    let i32min : i32 = -2147483647i32 - 1i32
    if (2000000000i32 *| 2i32) != i32max then bad = bad + 1i64
    if (-2000000000i32 *| 2i32) != i32min then bad = bad + 1i64
    if (i32min *| -1i32) != i32max then bad = bad + 1i64
    if (46340i32 *| 46340i32) != 2147395600i32 then bad = bad + 1i64
    let i64max : i64 = 9223372036854775807i64
    let i64min : i64 = -9223372036854775807i64 - 1i64
    if (4611686018427387904i64 *| 2i64) != i64max then bad = bad + 1i64
    if (-4611686018427387904i64 *| 2i64) != i64min then bad = bad + 1i64
    if (i64min *| -1i64) != i64max then bad = bad + 1i64
    if (3037000499i64 *| 3037000499i64) != 9223372030926249001i64 then bad = bad + 1i64
    if (3037000500i64 *| 3037000500i64) != i64max then bad = bad + 1i64
    if (0i64 *| i64max) != 0i64 then bad = bad + 1i64
    let u64max : u64 = 18446744073709551615u64
    if (4294967296u64 *| 4294967296u64) != u64max then bad = bad + 1i64
    if (4294967295u64 *| 4294967297u64) != u64max then bad = bad + 1i64
    if (4294967295u64 *| 4294967295u64) != 18446744065119617025u64 then bad = bad + 1i64
    bad
