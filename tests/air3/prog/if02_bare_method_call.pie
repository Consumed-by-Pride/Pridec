-- EXIT: 84
-- interface methods called as plain functions: `area(x)` is `x.area()`
interface Shape
  fn area : Self -> i64
  fn scale : (Self, i64) -> Self
struct Sq { s: i64; }
struct Rect { w: i64; h: i64; }
impl Shape for Sq
  fn area : Self -> i64 | q -> q.s * q.s
  fn scale : (Self, i64) -> Self | (q, k) -> Sq { s: q.s * k }
impl Shape for Rect
  fn area : Rect -> i64 | r -> r.w * r.h
  fn scale : (Self, i64) -> Self | (r, k) -> Rect { w: r.w * k, h: r.h }
fn total<T: Shape> : (T, T) -> i64
  | (a, b) -> area(a) + area(b)
fn main : () -> i64
  | () ->
      let q = Sq { s: 3 }
      let r = Rect { w: 2, h: 5 }
      total(q, q) + total(r, r) + area(scale(q, 2)) + area(r)
