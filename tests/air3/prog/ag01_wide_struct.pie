-- EXIT: 68
-- a struct with 24 fields by value (a record predicate holds 16: wider structs are built in memory), passed and returned
type Big = struct
  f0 : i64
  f1 : i64
  f2 : i64
  f3 : i64
  f4 : i64
  f5 : i64
  f6 : i64
  f7 : i64
  f8 : i64
  f9 : i64
  f10 : i64
  f11 : i64
  f12 : i64
  f13 : i64
  f14 : i64
  f15 : i64
  f16 : i64
  f17 : i64
  f18 : i64
  f19 : i64
  f20 : i64
  f21 : i64
  f22 : i64
  f23 : i64
fn sum : Big -> i64
  | b -> b.f0 + b.f1 + b.f2 + b.f3 + b.f4 + b.f5 + b.f6 + b.f7 + b.f8 + b.f9 + b.f10 + b.f11 + b.f12 + b.f13 + b.f14 + b.f15 + b.f16 + b.f17 + b.f18 + b.f19 + b.f20 + b.f21 + b.f22 + b.f23
fn bump : Big -> Big
  | b -> Big { f0: b.f0 + 1, f1: b.f1 + 1, f2: b.f2 + 1, f3: b.f3 + 1, f4: b.f4 + 1, f5: b.f5 + 1, f6: b.f6 + 1, f7: b.f7 + 1, f8: b.f8 + 1, f9: b.f9 + 1, f10: b.f10 + 1, f11: b.f11 + 1, f12: b.f12 + 1, f13: b.f13 + 1, f14: b.f14 + 1, f15: b.f15 + 1, f16: b.f16 + 1, f17: b.f17 + 1, f18: b.f18 + 1, f19: b.f19 + 1, f20: b.f20 + 1, f21: b.f21 + 1, f22: b.f22 + 1, f23: b.f23 + 1 }
fn main : () -> i64 | () ->
  let b = Big { f0: 1, f1: 2, f2: 3, f3: 4, f4: 5, f5: 6, f6: 7, f7: 8, f8: 9, f9: 10, f10: 11, f11: 12, f12: 13, f13: 14, f14: 15, f15: 16, f16: 17, f17: 18, f18: 19, f19: 20, f20: 21, f21: 22, f22: 23, f23: 24 }
  let c = bump(b)
  sum(c) % 256
