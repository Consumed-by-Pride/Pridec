-- EXIT: 95
-- `for x in xs` over a slice, an array, a literal array and a `mut` element binding; `continue`/`break` in it
fn sum : [i64] -> i64
  | xs ->
      let mut s : i64 = 0
      for x in xs
        s = s + x
      s
fn first_big : [i64] -> i64
  | xs ->
      let mut r : i64 = 0 - 1
      for x in xs
        if x > 10
          r = x
          break
      r
fn main : () -> i64
  | () ->
      let a : [i64; 4] = [1, 2, 3, 4]
      let mut t : i64 = 0
      for i in 0..10
        t = t + i
      for y in a
        if y == 2
          continue
        t = t + y
      for z in [100, 7, 5]
        t = t + z
      t + sum(a) + first_big([3, 20, 9]) - 100
