-- EXIT: 208
-- a handler with 12 operations: tail-resumptive arms, one arm that is not tail-resumptive (fiber mode), and a return arm
effect Big
  op0 : i64 -> i64
  op1 : i64 -> i64
  op2 : i64 -> i64
  op3 : i64 -> i64
  op4 : i64 -> i64
  op5 : i64 -> i64
  op6 : i64 -> i64
  op7 : i64 -> i64
  op8 : i64 -> i64
  op9 : i64 -> i64
  op10 : i64 -> i64
  op11 : i64 -> i64
fn work : i64 -> i64 ! [Big]
  | n ->
      let mut s : i64 = n
      s = s + Big.op0(1i64)
      s = s + Big.op1(2i64)
      s = s + Big.op2(3i64)
      s = s + Big.op3(4i64)
      s = s + Big.op4(5i64)
      s = s + Big.op5(6i64)
      s = s + Big.op6(7i64)
      s = s + Big.op7(8i64)
      s = s + Big.op8(9i64)
      s = s + Big.op9(10i64)
      s = s + Big.op10(11i64)
      s = s + Big.op11(12i64)
      s
fn run : i64 -> i64
  | n ->
      handle work(n)
        | Big.op0 x k -> k (x * 2i64)
        | Big.op1 x k -> k (x * 2i64)
        | Big.op2 x k -> k (x * 2i64)
        | Big.op3 x k -> k (x * 2i64)
        | Big.op4 x k -> k (x * 2i64)
        | Big.op5 x k ->
            let r = k (x * 10i64)
            r + 1000i64
        | Big.op6 x k -> k (x * 2i64)
        | Big.op7 x k -> k (x * 2i64)
        | Big.op8 x k -> k (x * 2i64)
        | Big.op9 x k -> k (x * 2i64)
        | Big.op10 x k -> k (x * 2i64)
        | Big.op11 x k -> k (x * 2i64)
        | return(v) -> v + 1i64
fn main : () -> i64
  | () -> run(7i64) % 251i64
