-- EXIT: 44
-- a function with a non-C calling convention used as a function value (closure path) and passed to a higher-order function:
-- the value's adapter calls it with its own convention; the address as a raw pointer is for tables (an IDT), calling one is the caller's affair
#callconv("fast")
fn add3 : (i64, i64, i64) -> i64 | (a, b, c) -> a + b + c

#callconv("preserve_most")
fn twice : i64 -> i64 | x -> x * 2

fn apply : (fn(i64) -> i64, i64) -> i64 | (f, x) -> f(x)

fn main : () -> i64 | () ->
  let g = twice
  let k = 5i64
  let h = fn (x: i64) -> i64 { add3(x, k, 1i64) }
  let addr = twice as ptr
  if addr as i64 == 0 then 1 else apply(g, 10i64) + apply(h, 3i64) + add3(5i64, 5i64, 5i64) - 0i64 - 0i64
