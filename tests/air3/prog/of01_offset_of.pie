-- EXIT: 0
-- offset_of(T, field) and sizeof(T) against the layout the code actually uses (field addresses through a pointer)
struct Hdr
  tag  : u8
  size : i64
  flag : bool
  id   : i32
  next : ptr

fn main : () -> i64
  | () ->
    let mut h = Hdr { tag: 1u8, size: 2i64, flag: true, id: 3i32, next: null }
    let base = (&h as ptr) as i64
    let mut bad : i64 = 0i64
    if (&h.size as ptr) as i64 - base != offset_of(Hdr, size) as i64 then bad = bad + 1i64
    if (&h.id as ptr) as i64 - base != offset_of(Hdr, id) as i64 then bad = bad + 1i64
    if (&h.next as ptr) as i64 - base != offset_of(Hdr, next) as i64 then bad = bad + 1i64
    if offset_of(Hdr, tag) != 0 then bad = bad + 1i64
    if (sizeof(Hdr) as i64) < offset_of(Hdr, next) as i64 + 4i64 then bad = bad + 1i64
    bad
