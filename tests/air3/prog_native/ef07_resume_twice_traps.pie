-- EXIT: 132
-- Continuations are one-shot: resuming the same continuation a second time traps (SIGILL, 128 + 4) instead of running the body twice.
effect Ask
  ask : i64 -> i64
fn body : () -> i64 ! [Ask]
  | () -> Ask.ask(1) + 1
fn main : () -> i64
  | () ->
      handle body()
        | Ask.ask n k -> (k 1) + (k 2)
