-- EXIT: 3
-- extern globals: storage defined outside the program (libc's `environ`, the linker's `__bss_start`); only their address is used here
#extern("environ")
let mut ENV : *u8

#extern("__bss_start")
let BSS : u8

-- #export names the symbol of a definition
#export("pride_counter")
#used
let mut COUNTER : i64 = 2

fn main : () -> i64
  | () ->
      let p = &ENV
      let q = &BSS
      let c = &COUNTER
      if p as i64 == 0 then 1 else (if q as i64 == 0 then 2 else (*c + 1))
