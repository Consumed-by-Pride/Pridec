-- EXIT: 15
-- A generator: the body yields 1..5 from a while loop; the arm adds the yielded value to the sum of everything yielded after it.
-- The return arm ends the chain with 0, so the result is 1 + (2 + (3 + (4 + (5 + 0)))) = 15.
effect Gen
  yield : i64 -> i64
fn produce : () -> i64 ! [Gen]
  | () ->
      let mut i : i64 = 1
      while i <= 5
        let _ : i64 = Gen.yield(i)
        i = i + 1
      0
fn main : () -> i64
  | () ->
      handle produce()
        | Gen.yield x k -> x + (k 0)
        | return(_r) -> 0
