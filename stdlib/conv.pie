mod conv

-- stdlib/conv.pie — primitive conversions between the fixed-width integer
-- and floating-point types. These are thin wrappers around `as` casts so
-- user code doesn't have to write the conversion style inline.

-- §1  INT-WIDENING
fn i8_to_i16   : i8 -> i16    | x -> x as i16
fn i8_to_i32   : i8 -> i32    | x -> x as i32
fn i8_to_i64   : i8 -> i64    | x -> x as i64
fn i16_to_i32  : i16 -> i32   | x -> x as i32
fn i16_to_i64  : i16 -> i64   | x -> x as i64
fn i32_to_i64  : i32 -> i64   | x -> x as i64

fn u8_to_u16   : u8 -> u16    | x -> x as u16
fn u8_to_u32   : u8 -> u32    | x -> x as u32
fn u8_to_u64   : u8 -> u64    | x -> x as u64
fn u16_to_u32  : u16 -> u32   | x -> x as u32
fn u16_to_u64  : u16 -> u64   | x -> x as u64
fn u32_to_u64  : u32 -> u64   | x -> x as u64

-- §2  SIGNED <-> UNSIGNED (same width)
fn i8_to_u8    : i8 -> u8     | x -> x as u8
fn u8_to_i8    : u8 -> i8     | x -> x as i8
fn i16_to_u16  : i16 -> u16   | x -> x as u16
fn u16_to_i16  : u16 -> i16   | x -> x as i16
fn i32_to_u32  : i32 -> u32   | x -> x as u32
fn u32_to_i32  : u32 -> i32   | x -> x as i32
fn i64_to_u64  : i64 -> u64   | x -> x as u64
fn u64_to_i64  : u64 -> i64   | x -> x as i64

-- §3  INT <-> PTR
fn i64_to_ptr  : i64 -> ptr   | x -> x as ptr
fn u64_to_ptr  : u64 -> ptr   | x -> x as ptr
fn ptr_to_i64  : ptr -> i64   | p -> p as i64
fn ptr_to_u64  : ptr -> u64   | p -> p as u64

-- §4  CHAR <-> INT
fn char_to_i32 : char -> i32  | c -> c as i32
fn i32_to_char : i32 -> char  | x -> x as char
fn char_to_u32 : char -> u32  | c -> c as u32
fn u32_to_char : u32 -> char  | x -> x as char

-- §5  BOOL <-> INT
fn bool_to_i64 : bool -> i64  | b -> if b { 1i64 } else { 0i64 }
fn i64_to_bool : i64 -> bool  | x -> x != 0i64
