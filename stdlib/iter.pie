mod iter

use iter.range

-- stdlib/iter.pie — iterator/loop utilities. Forwarding module: re-exports
-- the helpers defined in iter/range.pie.

fn range_contains : (i64, i64, i64) -> bool | (lo, hi, v) -> range.range_contains(lo, hi, v)
fn range_is_empty : (i64, i64) -> bool     | (lo, hi)    -> range.range_is_empty(lo, hi)
fn range_len : (i64, i64) -> i64           | (lo, hi)    -> range.range_len(lo, hi)
fn sum_range_i64 : (i64, i64) -> i64       | (a, b)      -> range.sum_range_i64(a, b)
fn product_range_i64 : (i64, i64) -> i64   | (a, b)      -> range.product_range_i64(a, b)
fn count_range_i64 : (i64, i64) -> i64     | (a, b)      -> range.count_range_i64(a, b)
