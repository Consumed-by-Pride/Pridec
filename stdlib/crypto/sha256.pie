mod crypto.sha256

use os.linux
use str.string
use crypto.hex

-- stdlib/crypto/sha256.pie — SHA-256 Cryptographic Hash Function
-- Computes 256-bit cryptographic digests for arbitrary byte buffers and strings.

const SHA256_DIGEST_LEN : i64 = 32i64
const SHA256_BLOCK_LEN  : i64 = 64i64

struct Sha256
  state      : *u32
  block      : *u8
  block_len  : i64
  total_len  : i64

fn sha256_new : () -> Sha256
  | () ->
    let st = os.linux.malloc(32i64) as *u32
    st[0i64] = 1779033703u32; st[1i64] = 3144134277u32
    st[2i64] = 1013904242u32; st[3i64] = 2773480762u32
    st[4i64] = 1359893119u32; st[5i64] = 2600822924u32
    st[6i64] = 528734635u32;  st[7i64] = 1541459225u32
    let blk = os.linux.malloc(64i64) as *u8
    os.linux.memset(blk as ptr, 0i32, 64u64)
    Sha256 { state: st, block: blk, block_len: 0i64, total_len: 0i64 }

fn sha256_destroy : *Sha256 -> ()
  | ctx ->
    if ctx.state as i64 != 0i64
      os.linux.free(ctx.state as ptr)
    if ctx.block as i64 != 0i64
      os.linux.free(ctx.block as ptr)
    ctx.state = 0 as *u32; ctx.block = 0 as *u8; ctx.block_len = 0i64; ctx.total_len = 0i64

fn sha256_rotr : (u32, u64) -> u32
  | (x, n) -> (x >> n) | (x << (32u64 - n))

fn sha256_k : () -> *u32
  | () ->
    -- FIPS 180-4 section 4.2.2: the first 32 bits of the fractional parts of the cube roots of the first 64 primes
    let k = os.linux.malloc(256i64) as *u32
    k[0i64] = 1116352408u32; k[1i64] = 1899447441u32; k[2i64] = 3049323471u32; k[3i64] = 3921009573u32
    k[4i64] = 961987163u32; k[5i64] = 1508970993u32; k[6i64] = 2453635748u32; k[7i64] = 2870763221u32
    k[8i64] = 3624381080u32; k[9i64] = 310598401u32; k[10i64] = 607225278u32; k[11i64] = 1426881987u32
    k[12i64] = 1925078388u32; k[13i64] = 2162078206u32; k[14i64] = 2614888103u32; k[15i64] = 3248222580u32
    k[16i64] = 3835390401u32; k[17i64] = 4022224774u32; k[18i64] = 264347078u32; k[19i64] = 604807628u32
    k[20i64] = 770255983u32; k[21i64] = 1249150122u32; k[22i64] = 1555081692u32; k[23i64] = 1996064986u32
    k[24i64] = 2554220882u32; k[25i64] = 2821834349u32; k[26i64] = 2952996808u32; k[27i64] = 3210313671u32
    k[28i64] = 3336571891u32; k[29i64] = 3584528711u32; k[30i64] = 113926993u32; k[31i64] = 338241895u32
    k[32i64] = 666307205u32; k[33i64] = 773529912u32; k[34i64] = 1294757372u32; k[35i64] = 1396182291u32
    k[36i64] = 1695183700u32; k[37i64] = 1986661051u32; k[38i64] = 2177026350u32; k[39i64] = 2456956037u32
    k[40i64] = 2730485921u32; k[41i64] = 2820302411u32; k[42i64] = 3259730800u32; k[43i64] = 3345764771u32
    k[44i64] = 3516065817u32; k[45i64] = 3600352804u32; k[46i64] = 4094571909u32; k[47i64] = 275423344u32
    k[48i64] = 430227734u32; k[49i64] = 506948616u32; k[50i64] = 659060556u32; k[51i64] = 883997877u32
    k[52i64] = 958139571u32; k[53i64] = 1322822218u32; k[54i64] = 1537002063u32; k[55i64] = 1747873779u32
    k[56i64] = 1955562222u32; k[57i64] = 2024104815u32; k[58i64] = 2227730452u32; k[59i64] = 2361852424u32
    k[60i64] = 2428436474u32; k[61i64] = 2756734187u32; k[62i64] = 3204031479u32; k[63i64] = 3329325298u32
    k

-- one-shot SHA-256 (FIPS 180-4): pad the message, run the 64-round compression over each 64-byte block, write the 32-byte big-endian digest
fn sha256_hash_bytes : (ptr, i64) -> ptr
  | (data, len) ->
    let mut ctx = sha256_new()
    let st = ctx.state
    let k = sha256_k()
    let w = os.linux.malloc(256i64) as *u32
    let padded = ((len + 8i64) / 64i64 + 1i64) * 64i64
    let msg = os.linux.malloc(padded) as *u8
    os.linux.memset(msg as ptr, 0i32, padded as u64)
    let src = data as *u8
    let mut i : i64 = 0i64
    while i < len
      msg[i] = src[i]
      i = i + 1i64
    msg[len] = 128u8
    let bits = (len as u64) * 8u64
    let mut q : i64 = 0i64
    while q < 8i64
      msg[padded - 1i64 - q] = ((bits >> ((q as u64) * 8u64)) & 255u64) as u8
      q = q + 1i64
    let mut off : i64 = 0i64
    while off < padded
      let mut t : i64 = 0i64
      while t < 16i64
        let b = off + t * 4i64
        w[t] = ((msg[b] as u32) << 24u64) | ((msg[b + 1i64] as u32) << 16u64) | ((msg[b + 2i64] as u32) << 8u64) | (msg[b + 3i64] as u32)
        t = t + 1i64
      while t < 64i64
        let x15 = w[t - 15i64]
        let x2  = w[t - 2i64]
        let s0 = sha256_rotr(x15, 7u64) ^ sha256_rotr(x15, 18u64) ^ (x15 >> 3u64)
        let s1 = sha256_rotr(x2, 17u64) ^ sha256_rotr(x2, 19u64) ^ (x2 >> 10u64)
        w[t] = w[t - 16i64] + s0 + w[t - 7i64] + s1
        t = t + 1i64
      let mut a = st[0i64]; let mut b = st[1i64]; let mut c = st[2i64]; let mut d = st[3i64]
      let mut e = st[4i64]; let mut f = st[5i64]; let mut g = st[6i64]; let mut h = st[7i64]
      let mut r : i64 = 0i64
      while r < 64i64
        let bs1 = sha256_rotr(e, 6u64) ^ sha256_rotr(e, 11u64) ^ sha256_rotr(e, 25u64)
        let ch  = (e & f) ^ ((e ^ 4294967295u32) & g)
        let t1  = h + bs1 + ch + k[r] + w[r]
        let bs0 = sha256_rotr(a, 2u64) ^ sha256_rotr(a, 13u64) ^ sha256_rotr(a, 22u64)
        let maj = (a & b) ^ (a & c) ^ (b & c)
        let t2  = bs0 + maj
        h = g; g = f; f = e; e = d + t1
        d = c; c = b; b = a; a = t1 + t2
        r = r + 1i64
      st[0i64] = st[0i64] + a; st[1i64] = st[1i64] + b; st[2i64] = st[2i64] + c; st[3i64] = st[3i64] + d
      st[4i64] = st[4i64] + e; st[5i64] = st[5i64] + f; st[6i64] = st[6i64] + g; st[7i64] = st[7i64] + h
      off = off + 64i64
    let digest = os.linux.malloc(32i64) as *u8
    let mut j : i64 = 0i64
    while j < 8i64
      let v = st[j]
      digest[j * 4i64]        = (v >> 24u64) as u8
      digest[j * 4i64 + 1i64] = (v >> 16u64) as u8
      digest[j * 4i64 + 2i64] = (v >> 8u64)  as u8
      digest[j * 4i64 + 3i64] = (v & 255u32) as u8
      j = j + 1i64
    os.linux.free(msg as ptr)
    os.linux.free(w as ptr)
    os.linux.free(k as ptr)
    sha256_destroy(&ctx)
    digest as ptr

fn sha256_hash_str : ptr -> string.String
  | cstr ->
    let len = os.linux.strlen(cstr) as i64
    let digest = sha256_hash_bytes(cstr, len)
    let s = hex.hex_encode_slice(digest, 32i64, false)
    os.linux.free(digest)
    s
