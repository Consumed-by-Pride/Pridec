# ── exec-suite artifacts ────────────────────────────────────────────────
# pfrontc writes the binary next to its source, so exec cases leave an
# extensionless file beside the .pie. Keep the sources, ignore everything else.
/tests/exec/pear/*
!/tests/exec/pear/*.pie
!/tests/exec/pear/run.sh
# ── bench binaries ──────────────────────────────────────────────────────
